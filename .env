# ================== BSC 网络 ==================

# BSC 主网 RPC（默认可用，也可以以后改成你自己的节点）
BSC_RPC_URL=https://bsc-dataseed3.binance.org

# BSC 测试网（以后调试用，目前不用）
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/


# ================== 部署钱包（重要） ==================

# ⭐⭐⭐ 钱包私钥（只能用于项目部署 & 支付少量测试Gas）
# ⭐⭐⭐ 建议新建一个钱包，只放少量BNB，不要放你主钱包资产
# 👉 格式：0x + 64位字符
PRIVATE_KEY=0x013c44a3940c1c417b4600172f6a9be1fcda401c678b980b2baa809458057994


# ================== ERC-4337 / Account Abstraction ==================

# EntryPoint v0.7.0 (BSC 主网固定地址)
ENTRY_POINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# 链 ID（BSC 主网 = 56）
CHAIN_ID=56
EXPO_PUBLIC_CHAIN_ID=56


# ================== RADRS Token ==================

# RADRS 官方 BSC 合约
RADRS_TOKEN_ADDRESS=0xe2188a2e0a41a50f09359e5fe714d5e643036f2a


# ================== Bundler（Pimlico） ==================
# ⭐ 4337 交易打包服务（一定要 bsc，不是 binance）
# EXPO_PUBLIC_BUNDLER_URL=https://api.pimlico.io/v2/bsc-mainnet/rpc?apikey=pim_iQCirstXBmWBPpMs9B9MHw
# BUNDLER_RPC_URL=https://api.pimlico.io/v2/bsc-mainnet/rpc?apikey=pim_iQCirstXBmWBPpMs9B9MHw
# 👇 使用公共端点进行测试
EXPO_PUBLIC_BUNDLER_URL=https://public.pimlico.io/v2/bsc-mainnet/rpc
BUNDLER_RPC_URL=https://public.pimlico.io/v2/bsc-mainnet/rpc


# ================== RADRS Paymaster（Gas 代付） ==================

# ⭐ Paymaster 合约地址（合约负责验证 & 扣RADRS 偿付）
EXPO_PUBLIC_RADRS_PAYMASTER_ADDRESS=0x524DF114a1F4E0cefC7a8c29df7cc900458b3943

# ⭐ Paymaster 服务 API（如有后端签名服务，在这里填）
# 没有的话先留空（我后面可以帮你部署）
PAYMASTER_SIGNER_KEY=0x51522ba5d94939fd40a8436b029d6457b02648a0891e7197df550a82a249b0d8
PAYMASTER_ADDRESS=0x524DF114a1F4E0cefC7a8c29df7cc900458b3943
EXPO_PUBLIC_PAYMASTER_API_URL=http://192.168.3.2:3000
